# ====================================================================
# Git Ignore Configuration for GameFlow Launcher
# ====================================================================

# Python & Virtual Environments
venv/
.venv/
env/
ENV/
*.py[cod]
*$py.class
__pycache__/

# Runtime Caches & Dynamic Assets
.cache/
.launch_timestamp
*.log
*.tmp
*.bak
.perm_test*

# PyInstaller / Distribution
dist/
build/
*.spec
!gameflow.spec

# User Personal Data & Custom Artwork (Untracked for clean distributions)
games.json
games.json.bak
gamepad_config.json
game_stats.json
cloud_sync.json
achievements_config.json
achievements_cache.json
collections_config.json
save_backups/
*.lnk
.portable
covers/*
!covers/.gitkeep
wallpapers/*
!wallpapers/.gitkeep

# IDE & OS Metadata
.vscode/
.idea/
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store

# User Scratch Temporary Outputs & Ad-Hoc Profiling/Migration Scripts
scratch/*.tmp
scratch/*.bak
scratch/patch_*.py
scratch/find_*.py
scratch/inspect_*.py
scratch/print_*.py
scratch/profile_*.py
scratch/benchmark_*.py
